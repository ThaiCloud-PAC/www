{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thaicloud-prod-www",
  "account_id": "09a8e413703cb77ee111db09ab232d19",
  "compatibility_date": "2026-08-15",
  "main": "worker.js",
  "vars": {
    "SITE_URL": "https://thaicloud.com"
  },
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
